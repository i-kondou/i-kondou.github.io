{% assign text = site.data.locales[page.lang] %}
{% assign title_field = 'title' %}
{% assign tag_field = 'tag' %}
{% if page.lang == 'en' %}
  {% assign title_field = 'title_en' %}
  {% assign tag_field = 'tag_en' %}
{% endif %}
<section class="hero" aria-labelledby="hero-name">
  <div class="hero-copy">
    <h1 id="hero-name">
      {{ text.name }}
      <span class="name-en" lang="{{ text.name_secondary_lang }}">{{ text.name_secondary }}</span>
    </h1>
    <p class="affiliation">
      {{ text.university -}}
      <br>
      {{ text.program -}}
      <br>
      <a href="{{ site.data.profile.lab_url }}">{{ text.lab }}</a>
    </p>
    <div class="intro-links">
      {% include personal-socials.liquid %}
    </div>
  </div>
  <img class="profile-photo" src="{{ site.data.profile.photo | relative_url }}" alt="{{ text.photo_alt }}" fetchpriority="high">
</section>
<section id="research" class="section-block" aria-labelledby="research-title">
  <h2 id="research-title">{{ text.research_heading }}</h2>
  {% include research-keywords.liquid %}
</section>
<section class="section-block selected-section" aria-labelledby="selected-title">
  <div class="section-heading">
    <h2 id="selected-title">{{ text.selected_work }}</h2>
    <a class="text-link" href="{{ text.routes.publications | relative_url }}">{{ text.all_publications }}</a>
  </div>
  {% bibliography -f papers -T publication -q @*[selected=true] --group_by none %}
</section>
<section class="section-block news-section" aria-labelledby="news-title">
  <h2 id="news-title">{{ text.news }}</h2>
  {% assign recent_activities = site.data.activities | where_exp: 'item', 'item.home != false' %}
  <ol class="news-list">
    {% for item in recent_activities limit: 6 %}
      <li>
        <time>{{ item.date | slice: 0, 7 }}</time><span class="news-tag">{{ item.home[tag_field] | default: item[tag_field] }}</span>
        <a href="{{ item.home.url | default: item.url }}">{{ item.home[title_field] | default: item[title_field] }}</a>
      </li>
    {% endfor %}
  </ol>
</section>
<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <h2 id="contact-title">{{ text.contact }}</h2>
  <p>{{ text.contact_intro }}</p>
  <a class="contact-email social-link" href="mailto:{{ site.data.profile.email }}">
    {%- include social-icon.liquid name='email' -%}
    {{- site.data.profile.email -}}
  </a>
  <div class="contact-links">
    {% include personal-socials.liquid %}
    <a href="{{ text.routes.cv | relative_url }}">{{ text.nav.cv }}</a>
  </div>
</section>
