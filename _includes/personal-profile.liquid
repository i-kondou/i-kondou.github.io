{% assign text = site.data.locales[page.lang] %}
{% assign suffix = '' %}
{% if page.lang == 'en' %}{% assign suffix = '_en' %}{% endif %}
{% assign date_field = 'date' | append: suffix %}
{% assign institution_field = 'institution' | append: suffix %}
{% assign program_field = 'program' | append: suffix %}
{% assign title_field = 'title' | append: suffix %}
{% assign organization_field = 'organization' | append: suffix %}
{% assign paper_field = 'paper' | append: suffix %}
<header class="page-heading">
  <h1>{{ text.nav.cv }}</h1>
  <p>
    {{ text.name }} / <span lang="{{ text.name_secondary_lang }}">{{ text.name_secondary }}</span>
  </p>
</header>
<section class="profile-section">
  <h2>{{ text.affiliation }}</h2>
  <div>
    <h3>{{ text.university }}</h3>
    <p>
      {{ text.program -}}
      <br>
      {{ text.lab }}
    </p>
    <a class="text-link" href="https://sel.ist.osaka-u.ac.jp/people/">{{ text.members }}</a>
  </div>
</section>
<section class="profile-section">
  <h2>{{ text.education }}</h2>
  <div class="award-list">
    {% for item in site.data.profile.education %}
      <article>
        <p class="eyebrow">{{ item[date_field] }}</p>
        <h3>{{ item[institution_field] }}</h3>
        <p>{{ item[program_field] }}</p>
      </article>
    {% endfor %}
    <a class="text-link" href="{{ site.data.profile.researchmap_url }}/education">{{ text.on_researchmap }}</a>
  </div>
</section>
<section class="profile-section">
  <h2>{{ text.research_area }}</h2>
  <div>
    {% include research-keywords.liquid %}
    <a class="text-link" href="{{ text.routes.publications | relative_url }}">{{ text.view_publications }}</a>
  </div>
</section>
<section class="profile-section">
  <h2>{{ text.awards }}</h2>
  <div class="award-list">
    {% for item in site.data.profile.awards %}
      <article>
        <p class="eyebrow">{{ item.date }}</p>
        <h3>{{ item[title_field] }}</h3>
        <p>
          {% if item[organization_field] -%}
            {{- item[organization_field] -}}
            <br>
          {% endif -%}
          {{- item[paper_field] -}}
          {%- if item.shared -%}
            <br>
            {{ text.shared_award -}}
          {%- endif %}
        </p>
        <a class="text-link" href="{{ item.url }}">{{ text.award_details }}</a>
      </article>
    {% endfor %}
  </div>
</section>
<section class="profile-section">
  <h2>{{ text.links }}</h2>
  <div class="profile-links">
    <a href="mailto:{{ site.data.profile.email }}" class="social-link">
      {%- include social-icon.liquid name='email' -%}
      {{- site.data.profile.email -}}
    </a>
    {% include personal-socials.liquid %}
    <a href="{{ site.data.profile.lab_url }}">{{ text.lab_short }}</a>
  </div>
</section>
