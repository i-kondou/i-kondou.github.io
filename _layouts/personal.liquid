{% assign lang = page.lang | default: 'ja' %}
{% assign text = site.data.locales[lang] %}
{% assign other_lang = 'en' %}
{% if lang == 'en' %}{% assign other_lang = 'ja' %}{% endif %}
{% assign other_text = site.data.locales[other_lang] %}
{% assign translation_url = other_text.routes[page.page_id] | default: other_text.routes.home %}
<!doctype html>
<html lang="{{ page.lang | default: site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% unless page.home %}{{ page.title | escape }} · {% endunless %}
      {% if lang == 'en' %}Inase Kondo{% else %}近藤 偉成 / Inase Kondo{% endif %}
    </title>
    <meta name="description" content="{{ page.description | default: text.description | strip | escape }}">
    <meta name="theme-color" content="#ffffff">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page.title | escape }} · Inase Kondo">
    <meta property="og:description" content="{{ page.description | default: text.description | strip | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ site.data.profile.photo | absolute_url }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    {% if page.page_id %}
      <link rel="alternate" hreflang="{{ lang }}" href="{{ page.url | absolute_url }}">
      <link rel="alternate" hreflang="{{ other_lang }}" href="{{ translation_url | absolute_url }}">
    {% endif %}
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/ik-mark.svg' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/scholar-icons.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/personal.css' | relative_url }}">
    <script src="{{ '/assets/js/personal.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{{ text.skip }}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="{{ text.routes.home | relative_url }}" aria-label="{{ text.home_label }}">Inase Kondo</a>
        <nav aria-label="{{ text.navigation }}">
          {% for item in text.nav %}
            {% assign route_key = item[0] %}
            <a
              href="{{ text.routes[route_key] | relative_url }}"
              {% if page.page_id == route_key %}
                aria-current="page"
              {% endif %}
            >
              {{- item[1] -}}
            </a>
          {% endfor %}
        </nav>
        <div class="header-tools">
          <a
            class="language-link"
            href="{{ translation_url | relative_url }}"
            lang="{{ other_lang }}"
            hreflang="{{ other_lang }}"
            aria-label="{% if other_lang == 'en' %}View this page in English{% else %}このページを日本語で表示{% endif %}"
          >
            {%- if other_lang == 'en' %}EN{% else %}JP{% endif -%}
          </a>
          <button
            class="theme-toggle"
            type="button"
            aria-label="{{ text.theme_toggle }}"
            aria-pressed="false"
            hidden
          >
            <span aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="site-main" tabindex="-1">{{ content }}</main>
    <footer class="site-footer">
      <div>
        <a class="footer-name" href="{{ text.routes.home | relative_url }}">Inase Kondo<span lang="ja">近藤 偉成</span></a>
        <p>Software Engineering · The University of Osaka</p>
      </div>
      <div class="footer-meta">
        <span>© {{ 'now' | date: '%Y' }} Inase Kondo</span
        ><span>Built with <a href="https://jekyllrb.com/">Jekyll</a> & <a href="https://github.com/alshedivat/al-folio">al-folio</a></span>
      </div>
    </footer>
  </body>
</html>
